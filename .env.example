# ─────────────────────────────────────────────────────────────
# web3-wallet-dashboard — environment variables template
#
# 1. Copy this file to `.env.local` (gitignored) and fill values.
# 2. NEVER commit `.env.local`. This demo is READ-ONLY and needs
#    NO private key — it never sends transactions.
# 3. On Vercel: Project → Settings → Environment Variables,
#    add every `NEXT_PUBLIC_*` key below.
# ─────────────────────────────────────────────────────────────

# ─── FRONTEND (exposed to browser, all NEXT_PUBLIC_*) ────────

# Public RPC used by the browser (wagmi). A public endpoint works,
# but a free Alchemy key is faster/more reliable:
# https://dashboard.alchemy.com → Create App → Sepolia
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# WalletConnect / Reown project id — required by RainbowKit.
# Get one free at https://cloud.reown.com (formerly WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ─── CROSS-DEMO LINKS (the "呼应" wiring) ─────────────────────

# Address of the MyNFT contract you deployed in web3-nft-gallery.
# When set, this dashboard reads tokensOfOwner() and shows the NFTs
# you minted in the gallery — the two demos link up.
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Public demo URLs, used by the cross-links footer/nav.
NEXT_PUBLIC_DEMO_NFT_GALLERY=http://localhost:3002
NEXT_PUBLIC_DEMO_PORTFOLIO=http://localhost:3000

# ─── OPTIONAL: transaction history ───────────────────────────

# Free Etherscan API key. Without it the "Recent activity" panel
# shows a hint instead of transactions (everything else still works).
# Get one at https://etherscan.io/myapikey
NEXT_PUBLIC_ETHERSCAN_API_KEY=
